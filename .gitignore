# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Caches and test runners
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/
ENV/

# Large datasets & raw research data (as per brief: document download, do not commit)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Reports figures can be kept or generated, but let's allow reports/figures/
# Streamlit local configurations
.streamlit/secrets.toml

# Distribution / packaging
build/
dist/
*.egg-info/

# Frontend (Node / Vite)
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local
.eslintcache
